# Required: obtain from @BotFather. Do not commit the real value.
BOT_TOKEN=replace-with-telegram-bot-token

# Required: use a long, unique secret. The first chat sending /pair <code> wins.
PAIR_CODE=replace-with-a-long-random-pairing-code

# Optional: extra text appended to the system prompt (system prompt supplement).
# Use \n for newlines.  Example: "Always use Python 3.12 features.\nPrefer pathlib."
# TELEGRAM_AGENTKNIT_SYSTEM_PROMPT_SUPPLEMENT=""

# Optional: default project selected at startup. A folder name under $HOME,
# a ~/path, or an absolute path. Must be a git repository (work-tree root)
# with at least one configured remote. Select/change at runtime with /projects.
# TELEGRAM_AGENTKNIT_PROJECT="telegram-agentknit-controller"

# Optional: multiple selectable agents, as a JSON array. Each entry needs a
# unique `key` plus either `spec_path` or both `model` and `endpoint`. Optional
# fields: `label`, `keyring_service`+`keyring_username`, `key_env`, and
# `system_prompt_supplement`. When unset, the controller ships two built-in
# agents derived from the single-agent config: the existing DeepSeek agent
# (from TELEGRAM_AGENTKNIT_MODEL/ENDPOINT) and GLM-5.2 (api.z.ai, key via the
# "z.ai"/"api_key" keyring entry). Select at runtime with /agent.
# TELEGRAM_AGENTKNIT_AGENTS='[{"key":"deepseek","label":"DeepSeek","model":"...","endpoint":"..."},{"key":"glm-5.2","label":"GLM-5.2","model":"glm-5.2","endpoint":"https://api.z.ai/api/coding/paas/v4","keyring_service":"z.ai","keyring_username":"api_key"}]'
