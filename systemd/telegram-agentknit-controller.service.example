[Unit]
Description=Private Telegram tmux/agentknit controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace every YOUR_USER and /path/to value before installing as a system service.
# For the simpler per-user service, use ../install.sh instead.
User=YOUR_USER
WorkingDirectory=/path/to/telegram-agentknit-controller
Environment=TELEGRAM_AGENTKNIT_CONFIG=/home/YOUR_USER/.config/telegram-agentknit-control.env
Environment=TELEGRAM_AGENTKNIT_STATE=/home/YOUR_USER/.local/state/telegram-agentknit-control.json
Environment=TELEGRAM_AGENTKNIT_TMUX_SESSION=web
Environment=TELEGRAM_AGENTKNIT_WORKSPACE=/path/to/workspace
Environment=TZ=Europe/Paris
# Point to your agent spec or model+endpoint:
# Environment=TELEGRAM_AGENTKNIT_SPEC=/home/YOUR_USER/.local/share/telegram-agentknit-controller/agent_spec.json
# Environment=TELEGRAM_AGENTKNIT_MODEL=deepseek-v4-flash-free
# Environment=TELEGRAM_AGENTKNIT_ENDPOINT=run:///home/YOUR_USER/bin/agent-binary.py
ExecStart=/path/to/telegram-agentknit-controller/telegram-agentknit-control.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
